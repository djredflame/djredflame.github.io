{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:frontend": "node dist/frontend/server/server.mjs",
    "lint": "ng lint",
    "lint:fix": "eslint . --ext .ts,.html --fix",
    "prettier": "prettier --check \"**/*.{ts,html,scss,css,md,json}\"",
    "prettier:fix": "prettier --write \"**/*.{ts,html,scss,css,md,json}\"",
    "build:pages": "ng build --configuration production --base-href=/",
    "build:pages:ssg": "ng build --configuration production --base-href=/ && ng run frontend:prerender",
    "deploy:pages": "pnpm run build:pages && pnpm dlx angular-cli-ghpages --dir=dist/frontend/browser --branch=gh-pages --message=\"deploy: pages (spa)\"",
    "deploy:pages:ssg": "pnpm run build:pages:ssg && pnpm dlx angular-cli-ghpages --dir=dist/frontend --branch=gh-pages --message=\"deploy: pages (ssg)\"",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox --progress=false"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.15",
      "eslint>minimatch": "3.1.4",
      "eslint-plugin-import>minimatch": "3.1.4",
      "karma-coverage>minimatch": "3.1.4",
      "@typescript-eslint/typescript-estree>minimatch": "9.0.7",
      "minimatch>brace-expansion": "1.1.13",
      "flat-cache>flatted": "3.4.2",
      "log4js>flatted": "3.4.2",
      "eslint>ajv": "6.14.0",
      "@eslint/eslintrc>js-yaml": "4.2.0",
      "karma>tmp": "0.2.7",
      "http-proxy>follow-redirects": "1.16.0",
      "socket.io>socket.io-parser": "4.2.6",
      "engine.io>ws": "8.21.0",
      "socket.io-adapter>ws": "8.21.0",
      "body-parser>qs": "6.15.2",
      "@angular/build>postcss": "8.5.15",
      "micromatch>picomatch": "2.3.2",
      "anymatch>picomatch": "2.3.2",
      "@angular-devkit/core>fast-uri": "3.1.2",
      "ajv>fast-uri": "3.1.2",
      "karma>lodash": "4.18.1"
    }
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.0",
    "express": "^5.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^9.35.0",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "angular-eslint": "21.4.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-rxjs": "^5.0.3",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "8.5.15",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.60.1"
  }
}
